# ==============================================================================
# AI SQL Detective — Environment Configuration Template
# Copy to root .env for local development. NEVER commit real secrets or .env.
# ==============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL 16 Container & Bootstrap Roles (Required) ---
POSTGRES_DB=ai_sql_detective
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-postgres-admin-password>
POSTGRES_PORT=5434

# Least-privilege application roles (provisioned by docker/postgres/init/01_init_roles.sh)
PG_MIGRATOR_USER=sql_detective_migrator
PG_MIGRATOR_PASSWORD=<set-migrator-password>

PG_RO_USER=sql_detective_ro
PG_RO_PASSWORD=<set-readonly-password>

PG_APP_USER=sql_detective_app
PG_APP_PASSWORD=<set-app-telemetry-password>

# --- Backend Database DSNs (Required — Psycopg 3 / SQLAlchemy 2) ---
# Dedicated read-only connection for target schema queries (ecommerce only)
DATABASE_RO_URL=postgresql+psycopg://sql_detective_ro:<set-readonly-password>@localhost:5434/ai_sql_detective
# Scoped telemetry connection for query-run recording (app_meta only)
DATABASE_APP_URL=postgresql+psycopg://sql_detective_app:<set-app-telemetry-password>@localhost:5434/ai_sql_detective
# Migration & seeding connection (Alembic / seed CLI only — not used by runtime HTTP endpoints)
DATABASE_MIGRATOR_URL=postgresql+psycopg://sql_detective_migrator:<set-migrator-password>@localhost:5434/ai_sql_detective

# Optional JSON array of additional preconfigured read-only PostgreSQL connections (backend-only):
EXTRA_CONNECTIONS_JSON=[]

# --- Query Execution & Security Guardrails ---
SQL_DEFAULT_MAX_ROWS=200
SQL_HARD_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_LOCK_TIMEOUT_MS=1000
WORKFLOW_TIMEOUT_SECONDS=60

# --- Provider-Agnostic LLM Configuration (LangChain) ---
# Supported providers via LangChain init_chat_model:
#   - openai          (langchain-openai)
#   - google_genai    (langchain-google-genai)
#   - mistralai       (langchain-mistralai)
#   - openrouter      (OpenAI-compatible via base_url)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=25

# --- Multi-Token & Multi-Provider Resilient Failover Pool ---
# High-Availability LLM Routing: Supports comma-separated keys (e.g. KEY1,KEY2,KEY3)
# Any token hitting HTTP 429 (rate limit) or 401 (invalid/expired) is quarantined for 5 min.
# The system instantly falls back to the next healthy token or provider without downtime.

# 1. Groq (Ultra-fast Llama-3.3-70B, generous free tier)
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 2. SambaNova / Sambanova.ai (High-throughput free Llama-3.3-70B & Qwen2.5-Coder-32B)
SAMBANOVA_API_KEYS=
SAMBANOVA_MODEL=Qwen2.5-Coder-32B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# 3. OpenRouter (Access to free Meta Llama 3.3, DeepSeek, and dozens of models)
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 4. Google Gemini (Free tier with generous RPM/TPM)
GOOGLE_API_KEYS=
GOOGLE_MODEL=gemini-2.0-flash

# 5. Cloudflare Workers AI (10,000 neurons/day free tier)
CLOUDFLARE_API_KEYS=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct
CLOUDFLARE_BASE_URL=

# 6. Cohere (Trial key available for Command R+)
COHERE_API_KEYS=
COHERE_MODEL=command-r-plus
COHERE_BASE_URL=https://api.cohere.com/v1

# 7. z.ai (OpenAI-compatible)
ZAI_API_KEYS=
ZAI_MODEL=default
ZAI_BASE_URL=https://api.z.ai/v1

# 8. Kimi / Moonshot AI (OpenAI-compatible)
KIMI_API_KEYS=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 9. Novita AI (OpenAI-compatible)
NOVITA_API_KEYS=
NOVITA_MODEL=meta-llama/llama-3.3-70b-instruct
NOVITA_BASE_URL=https://api.novita.ai/v3/openai

# 10. Meta Direct
META_API_KEYS=
META_MODEL=llama-3.3-70b-instruct

# 11. Mistral AI (Codestral / Mistral Small)
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest

# 12. OpenAI (Paid backup or credit tier)
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

# Priority cascade order for automated failover across providers:
# Fastest / free providers first, followed by commercial backups:
LLM_FALLBACK_CHAIN=groq,sambanova,openrouter,kimi,novita,google,cohere,cloudflare,zai,meta,mistral,openai

# --- Optional LangSmith Observability ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sql-detective

# --- Frontend (Public Non-Sensitive Config Only — NEVER place secrets under NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
